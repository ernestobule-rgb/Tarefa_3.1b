ida que se escreve." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#e0a060;fontSize=12;fontColor=#9a4100;align=left;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="520" width="300" height="60" as="geometry"/></mxCell><mxCell id="c74" value="EDITAR abre o formulário; VER abre a ficha em janela modal; REMOVER pede confirmação." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#e0a060;fontSize=12;fontColor=#9a4100;align=left;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="880" y="520" width="300" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="Browser · 4. Adicionar/editar patrocinador"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1144" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="rounded=0;arcSize=0;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="56" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=0;fillColor=none;strokeColor=#999999;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="17" width="22" height="22" as="geometry"/></mxCell><mxCell id="c4" value="ANIMALEC" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=17;fontColor=#333333;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="130" y="13" width="160" height="30" as="geometry"/></mxCell><mxCell id="c5" value="ANIMAIS" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=center;verticalAlig